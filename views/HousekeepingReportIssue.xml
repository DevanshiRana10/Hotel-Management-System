<odoo>
    <record id="view_housekeeping_report_form" model="ir.ui.view">
        <field name="name">housekeeping.report.issue.form</field>
        <field name="model">housekeeping.report.issue</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Report">
                <sheet>
                    <group>
                        <field name="issue_date"/>
                        <field name="guest_id"/>
                        <field name="hotel_id"/>
                        <field name="room_id"/>
                        <field name="maintenace_type_id"/>
                    </group>
                    <group>
                        <field name="status"/>
                        <field name="description"/>
                        <field name="staff_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_housekeeping_report_list" model="ir.ui.view">
        <field name="name">housekeeping.report.issue.list</field>
        <field name="model">housekeeping.report.issue</field>
        <field name="arch" type="xml">
            <list string="Housekeeping Report">
                <field name="issue_date"/>
                <field name="guest_id"/>
                <field name="hotel_id"/>
                <field name="room_id"/>
                <field name="maintenace_type_id"/>
                <field name="status"/>
                <field name="staff_id"/>
            </list>
        </field>
    </record>
    <record id="action_housekeeping_report_issue" model="ir.actions.act_window">
        <field name="name">Housekeeping Report Issue</field>
        <field name="res_model">housekeeping.report.issue</field>
        <field name="view_mode">form</field>
        <!-- <field name="target">new</field> -->
    </record>
</odoo>
