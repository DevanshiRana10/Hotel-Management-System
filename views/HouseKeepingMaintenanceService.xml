<odoo>
    <record id="view_housekeeping_maintenance_service_form" model="ir.ui.view">
        <field name="name">house.keeping.maintenance.service.form</field>
        <field name="model">house.keeping.maintenance.service</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Maintenance Service">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="maintenance_date"/>
                        <field name="staff_checklist"/>
                    </group>
                    <group>
                        <field name="maintenance_type_id"/>
                        <field name="staff_ids"/>
                        <field name="room_id"/>
                    </group>
                    <group>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_housekeeping_maintenance_service_list" model="ir.ui.view">
        <field name="name">house.keeping.maintenance.service.list</field>
        <field name="model">house.keeping.maintenance.service</field>
        <field name="arch" type="xml">
            <list string="Housekeeping Maintenance Service">
                <field name="name"/>
                <field name="maintenance_date"/>
                <field name="staff_checklist"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="action_housekeeping_maintenance_service" model="ir.actions.act_window">
        <field name="name">Housekeeping Maintenance Service</field>
        <field name="res_model">house.keeping.maintenance.service</field>
        <field name="view_mode">list,form</field>
        <field name="help">Manage the services provided by housekeeping staff</field>
    </record>
</odoo>
