<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Form View -->
    <record id="room_type_form_view" model="ir.ui.view">
    <field name="name">room.type.view.form</field>
    <field name="model">room.type</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                   <field name="name" />
                   <field name="capacity" />
                   <!-- <field name="ac_type" /> -->
                   <field name="base_price" /> 
                </group>
            </sheet>
        </form>
    </field>
    </record>

<!-- List View -->
    <record id="room_type_view_list" model="ir.ui.view">
        <field name="name">room.type.view.list</field>
        <field name="model">room.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="capacity" />
                <!-- <field name="ac_type" /> -->
                <field name="base_price" /> 
            </list>
        </field>
    </record>

    <record id="room_type_action" model="ir.actions.act_window">
        <field name="name">room type</field>
        <field name="res_model">room.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
