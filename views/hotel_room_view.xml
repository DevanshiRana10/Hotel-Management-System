    <record id="hotel_room_action" model="ir.actions.act_window">
        <field name="name">Hotel Room</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
                eval="[(5, 0, 0),
                        (0, 0, {'view_mode': 'list', 'view_id': ref('hotel_room_view_list')}),
                        (0, 0, {'view_mode': 'form', 'view_id': ref('hotel_room_view_form')})]"></field>
    </record>
    <record model="ir.actions.server" id="action_make_available">
            <field name="name">Make Available</field>
            <field name="model_id" ref="model_hotel_room"/>
            <field name="binding_model_id" ref="model_hotel_room" />
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">
                for rec in records:
                    if rec.status == 'occupied':
                        rec.make_available()

            </field>

    </record>


</odoo>