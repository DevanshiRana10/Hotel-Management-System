<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Form View -->
    <record id="hotel_room_view_form" model="ir.ui.view">
    <field name="name">hotel.room.view.form</field>
    <field name="model">hotel.room</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <group >
                        <field name="room_image" widget="image" class="oe_avatar" options="{'size': [500, 500]}"/>
                    </group>
                    <group  string="Hotel">
                        <field name="hotel_id" />
                    </group>
                    <group string="Type Price Capacity">
                        <field name="room_type_id" />
                        <field name="capacity" />
                        <field name="price" />
                    </group>
                    <group  string="Floor and Number">
                        <field name="room_number" />
                        <field name="floor" />
                    </group>
                    <group string="Status">
                        <field name="status" widget="radio"/>
                    </group>
                    <notebook>
                        <page  string="Services">
                            <field name="additional_services_ids" />
                        </page>
                        <page string="Specifications">
                            <field name="room_specification_ids" widget="many2many_checkbox" />
                        </page>
                    </notebook>
                </group>
            </sheet>
        </form>
    </field>
    </record>

<!-- List View -->
    <record id="hotel_room_view_list" model="ir.ui.view">
        <field name="name">hotel.room.view.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="hotel_id" />
                <field name="room_number" />
                <field name="floor" />
                <field name="room_type_id" />
                <field name="status" />
                <field name="price" />
            </list>
        </field>
    </record>
