<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Form View -->
    <record id="hotel_view_form" model="ir.ui.view">
    <field name="name">hotel.view.form</field>
    <field name="model">hotel</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <group>
                        <field name="hotel_image" widget="image" class="oe_avatar" options="{'size': [5000, 5000]}"/>
                    </group>
                    <group>
                        <field name="name"/>
                        <field name="location"/>
                        <field name="landmark"/>
                        <field name="rating" widget="priority"/>
                        <field name="amenities_ids" widget="many2many_tags"/>
                        <field name="service_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <notebook>
                    <page  string="Rooms Of The Hotel">
                        <field name="room_ids">
                            <list>
                                <field name="room_number" />
                                <field name="floor" />
                                <field name="price" />
                                <field name="room_type_id" />
                                <field name="status" />
                            </list>
                        </field>
                    </page>
                    <page  string="Hotel Policies">
                        <field name="policy_id" />
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
    </record>

<!-- List View -->
    <record id="hotel_view_list" model="ir.ui.view">
        <field name="name">hotel.view.list</field>
        <field name="model">hotel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="location" />
                <field name="landmark" />
                <!-- <field name="rating" />
                <field name="policy_id" />
                <field name="amenities_ids" />
                <field name="service_ids" /> -->
            </list>
        </field>
    </record>
<!-- kanban view -->
    <record id="hotel_view_kanban" model="ir.ui.view">
        <field name="name">hotel.view.kanban</field>
        <field name="model">hotel</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                    <div>
                        <!-- <div class="o_kanban_card"> -->
                        <div >
                            <field name="hotel_image" widget="image" options="{'size': [200, 200]}"/>
                        </div>
                        <!-- </div> -->
                        <div>
                            <field name="name"/>
                        </div>
                        <div>
                            <span><strong>Location:</strong> <field name="location"/></span><br/>
                            <span><strong>Landmark:</strong> <field name="landmark"/></span>
                        </div>
                        <div>
                            <span><strong>Rating:</strong> <field name="rating"/></span>
                        </div>
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    
    </record>
    <record id="hotel_action" model="ir.actions.act_window">
        <field name="name">Hotel</field>
        <field name="res_model">hotel</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids"
                eval="[(5, 0, 0),
                        (0, 0, {'view_mode': 'kanban','view_id': ref('hotel_view_kanban')}),
                        (0, 0, {'view_mode': 'form', 'view_id': ref('hotel_view_form')}),
                        (0, 0, {'view_mode': 'list'})]"/>

        <!-- <field name="view_id" ref="hotel_view_form" /> -->
    </record>



</odoo>
