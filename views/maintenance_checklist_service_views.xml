<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View checklist.service View Tree -->
    <record id="view_maintenance_checklist_service_list" model="ir.ui.view">
        <field name="name">view.checklist.service.list</field>
        <field name="model">checklist.service</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View checklist.service form -->
    <record id="view_maintenance_checklist_service_form" model="ir.ui.view">
        <field name="name">view.checklist.service.form</field>
        <field name="model">checklist.service</field>
        <field name="arch" type="xml">
            <form string="Maintenance Checklist Service">
                <sheet>
                    <field name="name" placeholder="Name"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View checklist.service search -->
    <record id="view_maintenance_checklist_service_search" model="ir.ui.view">
        <field name="name">view.checklist.service.search</field>
        <field name="model">checklist.service</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action checklist.service -->
    <record id="action_maintenance_checklist_service" model="ir.actions.act_window">
        <field name="name">Maintenance Checklist Service</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">checklist.service</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Maintenance Checklist Service.
            </p>
        </field>
    </record>

</odoo>
