<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- KANBAN VIEW -->
    <record id="hotel_room_view_user_kanban" model="ir.ui.view">
        <field name="name">hotel.room.view.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="room_type_id" groups_draggable="0" records_draggable="0" create="0">
                <templates>
                    <t t-name="kanban-box">
                    <div>
                        <div>
                            <field name="room_image" widget="image" options="{'size': [200, 200]}"/>
                        </div>
                        <div>
                            <field name="room_number"/>
                        </div>
                        <div>
                            <span><strong>Room Type:</strong> <field name="room_type_id"/></span>
                        </div>
                        <div>
                            <span><strong>price:</strong> <field name="price"/></span>
                        </div>
                        <div class="kanban-footer">
                            <t t-if="context.booking_mode">
                                <button string="Add Room"  name="add_room" type="object" class="btn-primary"/>
                            </t>
                            <t t-else="">
                                <button string="Book Now"  name="add_room" type="object" class="btn-success"/>
                            </t>
                        </div>
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

<!-- FORM VIEW -->

    <record id="hotel_user_room_view_form" model="ir.ui.view">
    <field name="name">hotel.user.room.view.form</field>
    <field name="model">hotel.room</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <group>
                        <field name="room_image" widget="image"  options="{'size': [50, 50]}" readonly="1"/>
                    </group>
                    <group  string="room details">
                        <field name="hotel_id" readonly="1"/>
                        <field name="floor" readonly="1"/>
                        <field name="room_number" readonly="1"/>
                        <field name="room_type_id" readonly="1"/>
                        <field name="capacity" />
                    </group>
                    <group name="name" string="Room Availbility">
                        <field name="status" readonly="1"/>
                    </group>
                    <group  string="Room Price">
                        <field name="price" readonly="1"/>
                    </group>
                </group>
                    <notebook>
                        <page  string="Room Services">
                            <field name="additional_services_ids" readonly="1"/>
                        </page>
                    </notebook>
            </sheet>
        </form>
    </field>
    </record>

    <record id="hotel_room_kanban_action" model="ir.actions.act_window">
        <field name="name">Hotel available room</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,form</field>
        <field name="target">current</field>
        <field name="view_ids"
                eval="[(5, 0, 0),
                        (0, 0, {'view_mode': 'kanban', 'view_id': ref('hotel_room_view_user_kanban')}),
                        (0, 0, {'view_mode': 'form', 'view_id': ref('hotel_user_room_view_form')})]"/>

    </record>


</odoo>
<!-- groups_draggable="0" -->