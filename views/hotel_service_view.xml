<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Form View -->
    <record id="hotel_service_form_view" model="ir.ui.view">
    <field name="name">hotel.service.view.form</field>
    <field name="model">hotel.service</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                   <field name="name" />
                </group>
            </sheet>
        </form>
    </field>
    </record>

<!-- List View -->
    <record id="hotel_service_list_view" model="ir.ui.view">
        <field name="name">hotel.service.view.list</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="hotel_service_action" model="ir.actions.act_window">
        <field name="name">Hotel Service</field>
        <field name="res_model">hotel.service</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
