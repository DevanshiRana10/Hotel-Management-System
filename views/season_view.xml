<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Form View -->
    <record id="season_form_view" model="ir.ui.view">
    <field name="name">season.view.form</field>
    <field name="model">season</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                   <field name="name" />
                   <field name="start_date" />
                   <field name="end_date" />
                   <field name="non_refundable" /> 
                </group>
            </sheet>
        </form>
    </field>
    </record>

<!-- List View -->
    <record id="season_list_view" model="ir.ui.view">
        <field name="name">season.view.list</field>
        <field name="model">season</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="non_refundable" /> 
            </list>
        </field>
    </record>

    <record id="season_action" model="ir.actions.act_window">
        <field name="name">Season Price</field>
        <field name="res_model">season</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
