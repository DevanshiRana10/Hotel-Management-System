<odoo>
    <record id="view_food_form" model="ir.ui.view">
        <field name="name">food.form</field>
        <field name="model">food</field>
        <field name="arch" type="xml">
            <form string="Food">
                <sheet>
                    <group>
                        <field name="food_image" widget="image" options="{'size': [200, 200]}"/>
                        <field name="name"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_food_list" model="ir.ui.view">
        <field name="name">food.list</field>
        <field name="model">food</field>
        <field name="arch" type="xml">
            <list string="Food">
                <field name="food_image" widget="image" options="{'size': [200, 200]}"/>
                <field name="name"/>
                <field name="price"/>

            </list>
        </field>
    </record> 

    <record id="food_kanban" model="ir.ui.view">
        <field name="name">food.view.kanban</field>
        <field name="model">food</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_horizontal" groups_draggable="0" records_draggable="0">
                <templates>
                    <t t-name="kanban-box">
                    <div>
                        <div>
                            <field name="food_image" widget="image" options="{'size': [200, 200]}"/>
                        </div>
                        <div>
                            <field name="name"/>
                        </div>
                        <div>
                            <span><strong>Price :</strong> <field name="price"/></span>
                        </div>
                        <div class="kanban-footer">
                            <button string="Add"  name="add_food" type="object" class="btn-primary"/>
                        </div>
                    </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="action_food" model="ir.actions.act_window">
        <field name="name">Food</field>
        <field name="res_model">food</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help">Manage food items for the restaurant</field>
    </record>

</odoo>
